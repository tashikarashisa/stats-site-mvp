---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 6);
---

<!doctype html>
<html lang="ja">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <style>
            main {
                width: 720px;
                max-width: calc(100% - 2em);
                margin: auto;
                padding: 2em 1em;
            }
            .hero {
                text-align: center;
                padding: 2em 0 2.5em;
                border-bottom: 1px solid #eee;
                margin-bottom: 2em;
            }
            .hero h1 {
                font-size: 2.2rem;
                margin: 0 0 0.3em;
                letter-spacing: 0.02em;
            }
            .hero .tagline {
                color: #666;
                font-size: 1rem;
                margin: 0;
            }
            .intro {
                margin: 0 0 2.5em;
                line-height: 1.9;
                color: #333;
            }
            .intro p {
                margin: 0 0 1em;
            }
            h2 {
                font-size: 1.15rem;
                margin: 0 0 1em;
                padding-bottom: 0.3em;
                border-bottom: 1px solid #eee;
            }
            .post-list {
                list-style: none;
                padding: 0;
                margin: 0;
            }
            .post-list li {
                padding: 1em 0;
                border-bottom: 1px solid #f0f0f0;
            }
            .post-list a {
                text-decoration: none;
                color: inherit;
                display: block;
            }
            .post-list a:hover .title {
                color: #c05621;
            }
            .post-list .title {
                font-size: 1.05rem;
                font-weight: 600;
                margin: 0 0 0.2em;
                transition: color 0.2s;
            }
            .post-list .date {
                font-size: 0.8rem;
                color: #999;
            }
        </style>
    </head>
    <body>
        <Header />
        <main>
            <div class="hero">
                <h1>たしからしさ</h1>
                <p class="tagline">確率と統計で世界を見直す、小さな研究所。</p>
            </div>

            <div class="intro">
                <p>
                    300円の宝くじから始めて、期待値・大数の法則を経て、金融のスプレッド、市場マイクロストラクチャの研究まで
                    ―― <strong>同じひとつの「確率のレンズ」</strong> で世界を降りていくメディアです。
                </p>
                <p>
                    各記事は L1（一般読者向けのワンフレーズ）から L6（研究者向けの学術文献）まで、
                    6階層の深掘り階段になっています。急いでいる人は太字だけ拾ってください。
                    数式は触れるインタラクティブで感覚に落とします。
                </p>
            </div>

            <h2>最新の記事</h2>
            <ul class="post-list">
                {
                    latest.map((post) => (
                        <li>
                            <a href={`/blog/${post.id}/`}>
                                <div class="title">{post.data.title}</div>
                                <div class="date">
                                    <FormattedDate date={post.data.pubDate} />
                                </div>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </main>
        <Footer />
    </body>
</html>
