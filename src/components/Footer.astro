---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
const today = new Date();
---

<footer>
	<div class="brand">
		<strong>たしからしさ</strong> ― 確率と統計で世界を見直す、小さな研究所
	</div>
	<div class="links">
		<a href="/">Home</a>
		<span class="sep">·</span>
		<a href="/blog">記事</a>
		<span class="sep">·</span>
		<a href="/about">このサイト</a>
		<span class="sep">·</span>
		<a href="/rss.xml" data-track="footer_rss">RSS</a>
		<span class="sep">·</span>
		<a href="https://note.com/tashikarashisa" target="_blank" rel="noopener" data-track="footer_note">note</a>
		<span class="sep">·</span>
		<a href="https://x.com/tashikarashisa" target="_blank" rel="noopener" data-track="footer_x">X</a>
		<span class="sep">·</span>
		<a href="https://github.com/tashikarashisa" target="_blank" rel="noopener" data-track="footer_github">GitHub</a>
	</div>
	<div class="copyright">
		&copy; {today.getFullYear()} Makoto Takahashi. All rights reserved.
	</div>
</footer>

<Analytics />
<SpeedInsights />

<script>
	// Send a custom Vercel Analytics event for any click on an <a data-track="...">.
	// The event name is the value of data-track; the href is attached as a property
	// so we can distinguish targets when the same name appears in multiple places.
	import { track } from '@vercel/analytics';

	document.addEventListener('click', (event) => {
		const target = event.target as HTMLElement | null;
		if (!target) return;
		const link = target.closest<HTMLAnchorElement>('a[data-track]');
		if (!link) return;
		const name = link.dataset.track;
		if (!name) return;
		track(name, { href: link.href, path: window.location.pathname });
	});
</script>

<style>
	footer {
		padding: 2em 1em 4em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.9rem;
		line-height: 1.7;
	}
	.brand {
		margin-bottom: 0.6em;
		color: rgb(var(--gray-dark));
	}
	.links {
		margin-bottom: 0.6em;
	}
	.links a {
		color: rgb(var(--gray));
		text-decoration: none;
		padding: 0 0.2em;
	}
	.links a:hover {
		color: rgb(var(--gray-dark));
		text-decoration: underline;
	}
	.links .sep {
		color: rgb(var(--gray));
		opacity: 0.5;
	}
	.copyright {
		font-size: 0.78rem;
		opacity: 0.7;
	}
</style>
