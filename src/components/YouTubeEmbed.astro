---
export interface Props {
	/** YouTube video ID (the part after v= or youtu.be/). */
	videoId: string;
	/** Title for the iframe — used as a11y label and browser tooltip. */
	title?: string;
	/** Optional caption shown under the video. */
	caption?: string;
}

const { videoId, title = 'YouTube 動画', caption } = Astro.props;

const src = `https://www.youtube-nocookie.com/embed/${videoId}?rel=0`;
---

<figure class="yt-embed">
	<div class="frame">
		<iframe
			src={src}
			title={title}
			loading="lazy"
			frameborder="0"
			allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
			referrerpolicy="strict-origin-when-cross-origin"
			allowfullscreen
		></iframe>
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.yt-embed {
		margin: 2em 0 2.5em 0;
	}
	.frame {
		position: relative;
		width: 100%;
		padding-bottom: 56.25%; /* 16:9 */
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 6px 32px rgba(0, 0, 0, 0.08);
		background: #000;
	}
	.frame iframe {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
	figcaption {
		margin-top: 0.6em;
		text-align: center;
		font-size: 0.9rem;
		color: rgb(var(--gray));
	}
</style>
